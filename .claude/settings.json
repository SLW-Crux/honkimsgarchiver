  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./setup-dev-environment.sh ] && ./setup-dev-environment.sh --quiet || echo \"ai-usage tracking: activation failed \u2014 run ./setup-dev-environment.sh and fix before committing\"'",
            "timeout": 30
          }
        ]
      }
    ]
